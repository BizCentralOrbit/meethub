# MeetHub Configuration
# ====================
# Add your ICS calendar feed URLs and optional client metadata below.
# Format: CALENDAR_<N>_URL, CALENDAR_<N>_NAME, CALENDAR_<N>_COLOR, CALENDAR_<N>_TIMEZONE
#
# HOW TO GET ICS URLS:
# Google Calendar: Settings > (select calendar) > "Secret address in iCal format"
# Outlook/Teams:   Settings > Calendar > Shared calendars > Publish a calendar > ICS link
#
# COLORS: Use any hex color (e.g., #3B82F6) or pick from these:
#   Blue=#3B82F6  Green=#10B981  Purple=#8B5CF6  Orange=#F59E0B
#   Red=#EF4444   Teal=#14B8A6  Pink=#EC4899     Indigo=#6366F1

# --- Calendar 1 ---
CALENDAR_1_URL=https://calendar.google.com/calendar/ical/your-secret-address/basic.ics
CALENDAR_1_NAME=Client A (Google)
CALENDAR_1_COLOR=#3B82F6
CALENDAR_1_TIMEZONE=America/New_York

# --- Calendar 2 ---
CALENDAR_2_URL=https://outlook.office365.com/owa/calendar/your-published-link/calendar.ics
CALENDAR_2_NAME=Client B (Teams)
CALENDAR_2_COLOR=#10B981
CALENDAR_2_TIMEZONE=Europe/London

# --- Calendar 3 ---
CALENDAR_3_URL=
CALENDAR_3_NAME=Client C
CALENDAR_3_COLOR=#8B5CF6
CALENDAR_3_TIMEZONE=Asia/Kolkata

# --- Calendar 4 ---
CALENDAR_4_URL=
CALENDAR_4_NAME=Client D
CALENDAR_4_COLOR=#F59E0B
CALENDAR_4_TIMEZONE=US/Pacific

# --- Calendar 5 ---
CALENDAR_5_URL=
CALENDAR_5_NAME=Client E
CALENDAR_5_COLOR=#EF4444
CALENDAR_5_TIMEZONE=Asia/Tokyo

# --- Calendar 6 ---
CALENDAR_6_URL=
CALENDAR_6_NAME=Client F
CALENDAR_6_COLOR=#14B8A6
CALENDAR_6_TIMEZONE=Europe/Berlin

# App password (optional, protects your dashboard from others)
APP_PASSWORD=
